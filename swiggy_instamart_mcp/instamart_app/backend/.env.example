GROQ_API_KEY=gsk_...

# Optional. Defaults to openai/gpt-oss-20b (the small, cheap GPT-OSS on Groq).
# Groq retires models periodically -- llama-3.3-70b-versatile was deprecated
# on 2026-06-17. If you get a model_not_found error, check the current list at
# https://console.groq.com/docs/models and set it here.
# GROQ_MODEL=openai/gpt-oss-120b

# Encrypts Swiggy tokens at rest AND signs the OAuth state parameter.
# MUST be exactly 64 hex chars:  openssl rand -hex 32
# Losing it means everyone has to reconnect. Never commit it.
ENCRYPTION_KEY=

# Public HTTPS origin of this backend. The OAuth redirect is built from it as
# ${PUBLIC_BASE_URL}/swiggy/auth/callback, and Swiggy requires redirect URIs to
# be exact-match HTTPS (http://localhost allowed for dev only).
# Once friends are using this, it MUST be https:// on a real domain -- their
# Swiggy tokens cross this connection.
PUBLIC_BASE_URL=https://your-backend.example.com

PORT=3000

# Where the OAuth callback page sends the browser when it is done. This is what closes the
# in-app sign-in sheet and returns the user to the app, instead of stranding them on a web
# page. Must match `scheme` in rx-ocr-expo/app/app.config.js.
APP_RETURN_URL=rxocr://connected

# Number of reverse proxies in front of this app. Set to 1 behind Dokploy/Traefik or nginx,
# and leave unset when running directly. Without it every request appears to come from the
# proxy's address, so the /enroll rate limit treats all users as one client and locks them
# out together. Do not set it when nothing sets X-Forwarded-For -- a client could then forge
# its own address.
# TRUST_PROXY=1

# Open enrollment. The app claims its own token from POST /enroll, so the only thing a user
# does is sign in to Swiggy. That token is inert until they do, because every route that
# spends anything sits behind requireConnected. Set ENROLL_DISABLED=1 to close sign-ups.
# ENROLL_DISABLED=1
# ENROLL_MAX_PER_HOUR=10
# ENROLL_TTL_HOURS=24
